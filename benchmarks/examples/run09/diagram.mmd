config:
  theme: base
  fontFamily: "Arial, sans-serif"
  themeCSS: "text { font-family: Arial, sans-serif !important; }"
  themeVariables:
    fontFamily: Arial, sans-serif
    fontSize: 20px
    primaryTextColor: '#172b3a'
    lineColor: '#718096'
    clusterBkg: '#f7fafd'
    clusterBorder: '#718da5'
  flowchart:
    htmlLabels: false
    wrappingWidth: 760
